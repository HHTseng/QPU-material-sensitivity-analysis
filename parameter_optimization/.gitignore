# Local secrets
.env
.env.*
!.env.example

# Generated/private catalog snapshots
catalog/private/


# ---------------------------------------------------------------------------
# Generated property-search artifacts. Added 2026-08-24.
#
# The linked-material factorial directories are tracked because they are small.
# Property-search directories are much larger and dominated by hit files from
# high-primary-count confirmations. GitHub would reject them.
# ---------------------------------------------------------------------------
runs/stage4_*/
logs_stage4/

# The SQLite result file is written by running evaluators, so a committed copy
# would be both large and internally inconsistent. Copy it with
# `finish_property_event_comparison.sh snapshot`, not with Git.
stage4_trials.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.bak-*

# Machine-local state recording which database is temporarily closed to new
# writers on this host.
*.sqlite.frozen
snapshots/

# Result JSONs live under the globally-ignored results/ tree. The ones that
# carry validity labels from stage4_reconcile.py, the corrected
# projection, the smoke tests -- are tracked deliberately via `git add -f`,
# because they are the record of what was withdrawn and why. Git cannot
# un-ignore files inside an ignored directory, so new ones must be force-added
# the same way; that is intentional friction, not an oversight.
*.prelabel
*.prebackfill
