# Local secrets
.env
.env.*
!.env.example

# Generated/private catalog snapshots
catalog/private/


# ---------------------------------------------------------------------------
# Stage 4 generated artifacts. Added 2026-08-24.
#
# The Stage 3 factorial run directories are tracked (they are small and were the
# v2 comparison baseline). Stage 4's are not: 489 MB and growing, dominated by
# hits files from 1e8-events-per-sub-run confirmations. They are reproducible
# from the code plus the ledger, and GitHub would reject them.
# ---------------------------------------------------------------------------
runs/stage4_*/
logs_stage4/

# The trial ledger is a live database (WAL) written by running evaluators, so a
# committed copy would be both large and torn. It is the campaign's primary
# record -- back it up with `stage4_post_xl.sh snapshot`, not with git.
stage4_trials.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.bak-*

# Machine-local operational state: which ledger is closed to new writers on THIS
# host. Created and removed by the post-XL runbook.
*.sqlite.frozen
