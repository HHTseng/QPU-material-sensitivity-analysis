# Generated run artifacts. Every Morris run mints a fresh UUID directory under
# both of these; together they reach hundreds of MB and are fully reproducible
# from the code plus a SENSITIVITY_MORRIS_SEED, so they are not tracked.
output/
results/
logs/

# Python
__pycache__/
*.py[cod]

# Editor / OS
.vscode/
.idea/
.DS_Store

# Local operational backups (e.g. pre-sync copies of macro templates)
backup_pre_mac_sync_*/

# Secrets: never commit API keys
legacy/.env
.env
*.env
!.env.example

# Revised material-scan runtime data. Definitions and small checking examples
# stay in Git; result databases, temporary files, compressed copies, logs, and
# generated plots do not.
material_scan_data/
*.sqlite-wal
*.sqlite-shm

# Locally retained outputs summarized by the checked files under material_scan/.
material_scan/experiments/orientation-pilot/results.json
material_scan/experiments/orientation-pilot/results.sqlite
data/hit_diagnostics_*/
# Local pre-migration ledger safety copies (the tracked .bak-* files remain).
data/premigration_backup_*/
parameter_optimization/runs/stage4_property_v1_orientation_pilot/
